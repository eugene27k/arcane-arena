# ---- dependencies ----
node_modules/

# ---- build output ----
dist/
.vite/
*.local

# ---- electron-builder output ----
release/
*.dmg
*.exe
*.blockmap
*.zip
*.AppImage

# ---- generated app icons: `npm run icon` renders all three from
#      tools/generateIcon.mjs, so none of them are source ----
build/

# ---- logs ----
*.log
npm-debug.log*

# ---- editors / OS ----
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.sw?

# ---- local agent / tooling config ----
.claude/
prompts/

# music/*.mp3 is deliberately NOT ignored. The three tracks are generated by
# `npm run music` (tools/generateMusic.mjs), but they are a hard build-time
# input for src/audio/bundledMusic.js's import.meta.glob. Without them the
# build SUCCEEDS and silently ships a game with no soundtrack. Regeneration
# also needs ffmpeg with libmp3lame, which npm cannot install.
